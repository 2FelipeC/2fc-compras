{
  "expo": {
    "name": "2FC-Compras",
    "slug": "2fc-compras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LOGO2FC.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fccompras.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fccompras.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/LOGO2FC.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a952216f-2fe7-4ae7-8519-ddbf0e64beed" 
      }
    }
  }
}
